  |  12:40:25 up 5 min,  load average: 0.00, 0.08, 0.06
  | console=ttyPS0,115200 earlycon
  | D1=0
  | root@linux:~#

  | f=0; for d in /boot /run/media/BOOT-mmcblk0p1 /run/media/* $DataDir
r /mnt; do if [ -e $d/BOOT.BIN ]; then echo BOOTBIN_AT=$d; sha256sum $d/BOOT.BIN;
; md5sum $d/BOOT.BIN; f=1; fi; done; echo BOOTBIN_SEEN=$f; test $f = 1; printf 'D
D''2=%s\n' $?
  | BOOTBIN_AT=/run/media/BOOT-mmcblk0p1
