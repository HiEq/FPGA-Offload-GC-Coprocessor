#!/bin/sh
# byobu status item "load_average" -> real CPU usage (same item name).
# The trailing space separates this item from cpu_count/cpu_freq on the right.
__load_average() {
    prev=/run/byobu_cpu.prev
    read _ u n s i w irq sirq steal _ < /proc/stat 2>/dev/null || return
    total=$((u + n + s + i + w + irq + sirq + steal))
    busy=$((total - i - w))
    pct=0
    if [ -r "$prev" ]; then
        read pt pb < "$prev" 2>/dev/null
        dt=$((total - pt)); db=$((busy - pb))
        [ "$dt" -gt 0 ] && pct=$((db * 100 / dt))
    fi
    printf "%s %s\n" "$total" "$busy" > "$prev" 2>/dev/null
    [ "$pct" -gt 99 ] && pct=99
    [ "$pct" -lt 0 ] && pct=0
    printf "%2d%% " "$pct"
}
__load_average_detail() { cat /proc/loadavg; }
